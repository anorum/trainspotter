---
/** The one page shell: head, masthead, main, footer. Every page is this
 * frame plus one island. */
import Masthead from "../components/Masthead.astro";
import { FEATURED, SOLO, crossingLabel } from "../lib/crossings";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active: "board" | "log" | "patterns" | "data";
}

const { title, description, active } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#0e141c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body>
    <Masthead active={active} />
    <main>
      <slot />
    </main>
    <footer>
      {
        /* The site shows fewer crossings than it watches, and the reader should
           hear it from the site rather than work it out from an absence. Reads
           off FEATURED, so re-adding a crossing retires the line by itself. */
        SOLO && (
          <p>
            {crossingLabel(FEATURED[0])} is the core crossing - the one
            PDX Train is dialed in on. More crossings will be added over time.
          </p>
        )
      }
      <p>
        Detection from public ODOT/PBOT traffic cameras on the Brooklyn
        Subdivision. States are automated estimates, not official information.
      </p>
      <p>
        The cameras publish on ODOT's schedule - a new frame every ~3 minutes,
        already ~2 minutes old when served - so the board runs a few minutes
        behind the street.
      </p>
      <p class="credits">
        <a href="https://alexnorum.com" rel="author">alexnorum.com</a>
        {" · "}
        <a href="https://github.com/anorum/trainspotter" rel="external">GitHub</a>
      </p>
    </footer>

    <style>
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
      }
      footer {
        max-width: 1100px;
        margin: 2rem auto 0;
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--hairline);
        color: var(--muted);
        font-size: 0.8rem;
      }
      /* The footer can hold two notes; they read as one small block rather
         than two paragraphs a full line apart. */
      footer p {
        margin: 0 0 0.4rem;
      }
      footer p:last-child {
        margin-bottom: 0;
      }
      footer a {
        color: var(--muted);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      footer a:hover,
      footer a:focus-visible {
        color: var(--crossbuck);
      }
    </style>
  </body>
</html>
