---
// The station sign: wordmark, tagline, and the site nav.
// `active` is the current page so its link reads as location, not action.
interface Props {
  active: "board" | "log" | "patterns";
}
const { active } = Astro.props;
---

<header class="masthead">
  <h1>Blockade</h1>
  <p class="tagline">Can you get across the tracks right now</p>
  <nav aria-label="Pages">
    <a href="/" aria-current={active === "board" ? "page" : undefined}>Board</a>
    <a href="/sessions/" aria-current={active === "log" ? "page" : undefined}>Train sheet</a>
    <a href="/patterns/" aria-current={active === "patterns" ? "page" : undefined}>Patterns</a>
  </nav>
</header>

<style>
  .masthead {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 1.5rem 0.5rem;
    border-bottom: 1px solid var(--hairline);
  }
  .masthead h1 {
    margin: 0;
    font-size: 1.9rem;
    line-height: 1;
  }
  .tagline {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    flex: 1;
  }
  nav {
    display: flex;
    gap: 1.25rem;
  }
  nav a {
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    font-size: 1rem;
  }
  nav a[aria-current="page"] {
    color: var(--crossbuck);
    border-bottom: 2px solid var(--signal-amber);
  }
  @media (max-width: 640px) {
    .tagline {
      display: none;
    }
  }
</style>
