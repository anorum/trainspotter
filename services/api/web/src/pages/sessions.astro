---
import "../styles/global.css";
import Masthead from "../components/Masthead.astro";
import SessionLog from "../components/SessionLog";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Train sheet - Blockade</title>
    <meta
      name="description"
      content="Every recorded train blockage at the SE Portland crossings, with the camera frames that saw it."
    />
  </head>
  <body>
    <Masthead active="log" />
    <main>
      <SessionLog client:load />
    </main>
    <footer>
      <p>
        Detection from public ODOT/PBOT traffic cameras on the Brooklyn
        Subdivision. States are automated estimates, not official information.
      </p>
    </footer>

    <style>
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
      }
      footer {
        max-width: 1100px;
        margin: 2rem auto 0;
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--hairline);
        color: var(--muted);
        font-size: 0.8rem;
      }
    </style>
  </body>
</html>
