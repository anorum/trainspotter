---
import "../styles/global.css";
import LiveBoard from "../components/LiveBoard";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blockade - SE Portland crossings</title>
    <meta
      name="description"
      content="Is a train blocking the crossing right now? Live status for the SE Portland rail crossings at 8th, Clinton, and Milwaukie."
    />
  </head>
  <body>
    <header class="masthead">
      <h1>Blockade</h1>
      <p class="tagline">Can you get across the tracks right now</p>
    </header>
    <main>
      <LiveBoard client:load />
    </main>
    <footer>
      <p>
        Detection from public ODOT/PBOT traffic cameras on the Brooklyn
        Subdivision. States are automated estimates, not official information.
      </p>
    </footer>

    <style>
      .masthead {
        display: flex;
        align-items: baseline;
        gap: 1rem;
        padding: 1rem 1.5rem 0.5rem;
        border-bottom: 1px solid var(--hairline);
      }
      .masthead h1 {
        margin: 0;
        font-size: 1.9rem;
        line-height: 1;
      }
      .tagline {
        margin: 0;
        color: var(--muted);
        font-size: 0.9rem;
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
      }
      footer {
        max-width: 1100px;
        margin: 2rem auto 0;
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--hairline);
        color: var(--muted);
        font-size: 0.8rem;
      }
    </style>
  </body>
</html>
