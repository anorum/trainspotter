{
  "Rules": [
    {
      "ID": "frames-tiering",
      "Status": "Enabled",
      "Filter": {
        "And": {
          "Prefix": "frames/",
          "ObjectSizeGreaterThan": 131072
        }
      },
      "Transitions": [
        {
          "Days": 30,
          "StorageClass": "STANDARD_IA"
        },
        {
          "Days": 90,
          "StorageClass": "GLACIER_IR"
        }
      ]
    },
    {
      "ID": "abort-incomplete-uploads",
      "Status": "Enabled",
      "Filter": {
        "Prefix": ""
      },
      "AbortIncompleteMultipartUpload": {
        "DaysAfterInitiation": 7
      }
    }
  ]
}
