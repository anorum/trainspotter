# Copy to .env and fill in. Never commit .env.

# --- ODOT TripCheck -----------------------------------------------------------
# Register at https://apiportal.odot.state.or.us/product/tripcheck-data-api and
# subscribe to the "TripCheck Data API" product. Two keys are issued; both are
# used, alternating, to stay under rate limits.
#
# Spent on the camera inventory only, which refreshes every 24h -- roughly one
# API call per day. Image polling goes straight to the per-camera image URLs and
# does not consume API quota.
BLOCKADE_ODOT_API_KEY=
BLOCKADE_ODOT_API_KEY_SECONDARY=

# Confirm the exact inventory URL against the portal's API definition after
# subscribing; the default below is the documented base path and is unverified.
# BLOCKADE_ODOT_INVENTORY_URL=https://api.odot.state.or.us/tripcheck/Cameras/Inventory

# --- TriMet (Phase 1+, MAX suppression) ---------------------------------------
# Free AppID: https://developer.trimet.org/appid/registration/
BLOCKADE_TRIMET_APP_ID=

# --- Storage ------------------------------------------------------------------
BLOCKADE_S3_BUCKET=blockade
BLOCKADE_S3_REGION=us-west-2
# Leave unset for real AWS S3. Point at MinIO/localstack for the demo stack.
# BLOCKADE_S3_ENDPOINT_URL=http://localhost:9000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Local paths --------------------------------------------------------------
BLOCKADE_LOCAL_CACHE_DIR=var/frames
BLOCKADE_MANIFEST_DIR=var/manifests
BLOCKADE_LOCAL_CACHE_TTL_DAYS=7

# --- Politeness ---------------------------------------------------------------
# Put a real contact address here. Polling anonymously every 30s is how a key
# gets revoked, and a revoked key ends the project.
BLOCKADE_USER_AGENT=blockade/0.1 (+https://github.com/YOU/blockade; you@example.com)
BLOCKADE_METRICS_PORT=9102
