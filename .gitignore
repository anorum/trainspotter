.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/

# Local capture output. The corpus lives on disk and S3, never in git.
var/
data/frames/
*.jsonl.gz

# Hand-curated ground truth is the opposite of capture output: small, slow to
# produce, and the thing every accuracy claim rests on. It belongs in git.
!data/labels/*.jsonl

